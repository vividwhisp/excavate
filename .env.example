# ------------------------------------------------------------------
# Excavate environment configuration
# Copy to .env and fill in values. Never commit .env.
# ------------------------------------------------------------------

# --- App ---
APP_ENV=development
DEBUG=false
PORT=8080
BASE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:5173

# --- Postgres ---
DATABASE_URL=postgres://excavate:excavate@localhost:5432/excavate?sslmode=disable

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Sessions ---
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168

# --- Search (Google Programmable Search Engine, free tier) ---
# Create a CSE at https://programmablesearchengine.google.com/ then:
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=

# --- LLM (Google Gemini, free tier) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Pipeline tunables ---
MAX_SEARCH_RESULTS=8
MAX_EXTRACT_PAGES=5
MAX_CONTEXT_CHARS=24000
QUERY_CACHE_TTL_MINUTES=60
RATE_LIMIT_PER_HOUR=60