# ------------------------------------------------------------------
# Excavate environment configuration
# Copy to .env and fill in values. Never commit .env.
# ------------------------------------------------------------------

# App ---
APP_ENV=development
DEBUG=false
PORT=8080
BASE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:5173

# Postgres ---
DATABASE_URL=postgres://excavate:excavate@localhost:5432/excavate?sslmode=disable

# Redis ---
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Sessions ---
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168

# Search (Tavily, free tier: 1,000 credits/month, no credit card) ---
# Get a key at https://app.tavily.com
TAVILY_API_KEY=

# LLM (Google Gemini, free tier) ---
# Get a key at https://aistudio.google.com/apikey
# The backend falls back to mock providers if both keys above are empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

#  Pipeline tunables ---
MAX_SEARCH_RESULTS=8
MAX_EXTRACT_PAGES=5
MAX_CONTEXT_CHARS=24000
QUERY_CACHE_TTL_MINUTES=60
RATE_LIMIT_PER_HOUR=60