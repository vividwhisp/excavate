# ------------------------------------------------------------------
# Excavate environment configuration
# Copy to .env and fill in values. Never commit .env.
# ------------------------------------------------------------------

# App ---
APP_ENV=development
DEBUG=false
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Postgres ---
DATABASE_URL=postgres://excavate:excavate@localhost:5432/excavate?sslmode=disable

# Sessions ---
SESSION_TTL_HOURS=168

# Search (Tavily, free tier: 1,000 credits/month) ---
TAVILY_API_KEY=

# LLM (Google Gemini, free tier) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Pipeline tunables ---
MAX_SEARCH_RESULTS=8
MAX_EXTRACT_PAGES=5
MAX_CONTEXT_CHARS=24000
RESEARCH_MODE=auto
